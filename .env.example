APP_ENV=development
REDIS_URL=redis://localhost:6379/0
LEDGER_STORE=memory
ALLOW_DEV_AUTH=1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3015,http://localhost:3015

# Required in production. Only asymmetric Supabase signing keys are accepted.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
KAKAO_REST_API_KEY=
KAKAO_LOGIN_CLIENT_SECRET=

# RQ is used only when LEDGER_STORE=redis; memory mode processes Kakao inline.

# Required for the production Kakao transport.
KAKAO_WEBHOOK_SECRET=
KAKAO_CALLBACK_HOSTS=

# Required in production. Generate a Fernet key instead of using this placeholder.
LEDGER_ENCRYPTION_KEY=
LEDGER_USER_REF_SECRET=
LEDGER_RETENTION_DAYS=365

# Optional in development. Without it, the deterministic fallback judge is used.
OPENAI_API_KEY=
OPENAI_LEDGER_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=20
OPENAI_JUDGMENT_ATTEMPTS=2
OPENAI_LEDGER_MAX_OUTPUT_TOKENS=700
AI_JUDGMENT_DAILY_QUOTA=50
AI_JUDGMENT_DAILY_WINDOW_SECONDS=86400
AI_JUDGMENT_RATE_LIMIT=10
AI_JUDGMENT_RATE_WINDOW_SECONDS=60

# Optional redacted telemetry sink.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_JSON=
